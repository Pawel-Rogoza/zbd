#!/usr/bin/env bash
set -Eeuo pipefail
umask 027

APP_DIR="${ZBD_APP_DIR:-/home/zbd}"
BRANCH="${ZBD_BRANCH:-main}"
PHP_FPM_SERVICE="${ZBD_PHP_FPM_SERVICE:-}"
BACKUP_DIR="${ZBD_BACKUP_DIR:-/var/backups/zbd}"

log() { printf '[deploy-zbd] %s\n' "$*"; }
die() { printf '[deploy-zbd] ERROR: %s\n' "$*" >&2; exit 1; }

if [[ ${EUID} -ne 0 ]]; then
  exec sudo env \
    ZBD_APP_DIR="$APP_DIR" \
    ZBD_BRANCH="$BRANCH" \
    ZBD_PHP_FPM_SERVICE="$PHP_FPM_SERVICE" \
    ZBD_BACKUP_DIR="$BACKUP_DIR" \
    "$0" "$@"
fi

command -v git >/dev/null || die 'Brak git.'
command -v nginx >/dev/null || die 'Brak nginx.'
command -v systemctl >/dev/null || die 'Brak systemctl.'
command -v php >/dev/null || die 'Brak PHP CLI.'
id zbd >/dev/null 2>&1 || die 'Użytkownik zbd nie istnieje.'
[[ -d "$APP_DIR/.git" ]] || die "Brak repozytorium Git w $APP_DIR."
[[ -f "$APP_DIR/config.php" ]] || die "Brak $APP_DIR/config.php — utwórz go z config.example.php."

php -r '$c = require $argv[1]; foreach (["site_url", "contact_email", "from_email"] as $k) { $valid = $k === "site_url" ? filter_var($c[$k] ?? "", FILTER_VALIDATE_URL) : filter_var($c[$k] ?? "", FILTER_VALIDATE_EMAIL); if (!$valid) { fwrite(STDERR, "Nieprawidłowa konfiguracja: $k" . PHP_EOL); exit(1); } } if (strlen((string) ($c["app_secret"] ?? "")) < 32) { fwrite(STDERR, "Brak app_secret." . PHP_EOL); exit(1); } $transport = strtolower((string) ($c["mail_transport"] ?? "smtp")); if (!in_array($transport, ["smtp", "mail"], true)) { fwrite(STDERR, "Nieprawidłowy mail_transport." . PHP_EOL); exit(1); } $smtpConfigured = filter_var($c["smtp_host"] ?? "", FILTER_VALIDATE_DOMAIN, FILTER_FLAG_HOSTNAME) && ($c["smtp_username"] ?? "") !== "" && ($c["smtp_password"] ?? "") !== ""; if ($transport === "smtp" && !$smtpConfigured) { fwrite(STDERR, "Ostrzeżenie: SMTP nie jest jeszcze skonfigurowane; formularz będzie wymagał danych SMTP przed wysyłką." . PHP_EOL); } if (($c["admin_enabled"] ?? false) === true && ($c["admin_password_hash"] ?? "") === "") { fwrite(STDERR, "Panel włączony bez hasła." . PHP_EOL); exit(1); }' "$APP_DIR/config.php" || die 'Konfiguracja config.php jest nieprawidłowa.'

if php -r '$c = require $argv[1]; $smtpConfigured = filter_var($c["smtp_host"] ?? "", FILTER_VALIDATE_DOMAIN, FILTER_FLAG_HOSTNAME) && ($c["smtp_username"] ?? "") !== "" && ($c["smtp_password"] ?? "") !== ""; exit(($c["mail_transport"] ?? "smtp") === "smtp" && $smtpConfigured ? 0 : 1);' "$APP_DIR/config.php"; then
  [[ -f "$APP_DIR/vendor/autoload.php" ]] || die 'Brak vendor/autoload.php — uruchom composer install --no-dev.'
else
  log 'Pomijam wymaganie PHPMailer: SMTP nie jest jeszcze skonfigurowane.'
fi

cd "$APP_DIR"

if [[ -n "$(git status --porcelain --untracked-files=all | grep -Ev '^\?\? (config\.php|assets/images/uploads/)' | grep -Ev '^( M|M )data/content\.json$' || true)" ]]; then
  git status --short
  die 'Repozytorium ma lokalne zmiany. Zapisz je lub wyczyść przed wdrożeniem.'
fi

if [[ -f data/content.json || -f config.php || -d assets/images/uploads ]]; then
  install -d -m 0750 "$BACKUP_DIR"
  backup_file="$BACKUP_DIR/zbd-$(date +%Y%m%d-%H%M%S).tgz"
  tar -czf "$backup_file" \
    --ignore-failed-read \
    -C "$APP_DIR" config.php data/content.json assets/images/uploads
  chmod 0600 "$backup_file"
  log "Backup: $backup_file"
fi

log "Pobieram origin/$BRANCH..."
git fetch --prune origin "$BRANCH"
git merge --ff-only "origin/$BRANCH" || die 'Fast-forward nie jest możliwy. Nie nadpisuję lokalnych zmian.'

if [[ -n "${backup_file:-}" ]]; then
  tar -xzf "$backup_file" -C "$APP_DIR"
  log 'Przywrócono lokalną konfigurację, treść panelu i uploady.'
fi

FPM_POOL_USER="$(ps -eo user,args | awk '$0 ~ /php-fpm: pool/ && $1 != "root" { print $1; exit }')"
if [[ -z "$FPM_POOL_USER" ]]; then
  log 'Nie wykryto użytkownika PHP-FPM; używam grupy zbd dla plików zapisywalnych.'
  FPM_POOL_GROUP='zbd'
else
  FPM_POOL_GROUP="$(id -gn "$FPM_POOL_USER" 2>/dev/null || printf '%s' "$FPM_POOL_USER")"
  log "Użytkownik PHP-FPM: $FPM_POOL_USER:$FPM_POOL_GROUP"
fi

install -d -o zbd -g "$FPM_POOL_GROUP" -m 0770 "$APP_DIR/data" "$APP_DIR/assets/images/uploads"
chown zbd:"$FPM_POOL_GROUP" "$APP_DIR/data/content.json" 2>/dev/null || true
chmod 0660 "$APP_DIR/data/content.json" 2>/dev/null || true

if [[ -z "$PHP_FPM_SERVICE" ]]; then
  PHP_FPM_SERVICE="$(systemctl list-units --type=service --all --no-legend \
    | awk '$1 == "php-fpm.service" || $1 ~ /^php[0-9.]+-fpm\.service$/ { print $1; exit }')"
fi
[[ -n "$PHP_FPM_SERVICE" ]] || die 'Nie znaleziono usługi PHP-FPM. Ustaw ZBD_PHP_FPM_SERVICE, np. php-fpm.service.'

log "Restartuję $PHP_FPM_SERVICE..."
systemctl restart "$PHP_FPM_SERVICE"
nginx -t
systemctl reload nginx

log "Gotowe: $(git rev-parse --short HEAD)"

